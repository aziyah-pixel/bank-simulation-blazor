@inherits LayoutComponentBase
@using simulasi_bank.Services
@inject BankService BankService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- TOP NAVIGATION BAR (MENGGANTIKAN ABOUT) -->
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="text-secondary fw-semibold small">SISTEM OPERASIONAL BANK</span>
            </div>

            @if (BankService.CurrentUser != null)
            {
                <div class="d-flex align-items-center gap-3">
                    <!-- Icon Orang + Nama User -->
                    <div class="d-flex align-items-center text-dark">
                        <!-- Icon Orang SVG -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#0d6efd" class="me-2" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                        </svg>
                        <span>
                            <strong class="me-1">@BankService.CurrentUser.NamaLengkap</strong>
                            <span class="badge bg-primary text-white">@BankService.CurrentUser.Role</span>
                        </span>
                    </div>

                    <!-- Tombol Logout -->
                    <button class="btn btn-outline-danger btn-sm px-3" @onclick="HandleLogout">
                        Keluar (Logout)
                    </button>
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void HandleLogout()
    {
        BankService.Logout();
        Navigation.NavigateTo("/");
    }
}