@page "/"
@layout Layout.EmptyLayout
@rendermode InteractiveServer

@using simulasi_bank.Services
@using simulasi_bank.Models
@inject BankService BankService
@inject NavigationManager Navigation

<PageTitle>Login - Bank Simulation</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card shadow p-4" style="width: 100%; max-width: 400px; border-radius: 12px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">Bank Simulation</h3>
            <p class="text-muted">Silakan masuk ke akun Anda</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Username</label>
            <input type="text" class="form-control" @bind="username" placeholder="Masukkan username" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" class="form-control" @bind="password" placeholder="Masukkan password" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small">
                @errorMessage
            </div>
        }

        <button class="btn btn-primary w-100 py-2 mt-2" @onclick="HandleLogin">
            Masuk
        </button>

        <div class="mt-4 p-2 bg-light rounded text-muted small">
            <div><strong>Akun Demo:</strong></div>
            <div>Teller: <code>teller1</code> | pass: <code>123</code></div>
            <div>Nasabah: <code>budi</code> | pass: <code>123</code></div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Username dan password tidak boleh kosong!";
            return;
        }

        // Cek login ke service
        var user = BankService.Login(username, password);

        if (user == null)
        {
            errorMessage = "Username atau password salah!";
            return;
        }

        errorMessage = "";

        // Arahkan ke halaman sesuai Role
        if (user.Role == UserRole.Teller)
        {
            Navigation.NavigateTo("/teller");
        }
        else if (user.Role == UserRole.Nasabah)
        {
            Navigation.NavigateTo("/nasabah");
        }
    }
}